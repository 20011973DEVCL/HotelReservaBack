@HotelReservaBack.Api_HostAddress = http://localhost:5071

# Todos los recursos exponen:
# GET /api/{recurso}
# GET /api/{recurso}/{id}
# POST /api/{recurso}
# PUT /api/{recurso}/{id}
# DELETE /api/{recurso}/{id}
#
# Recursos:
# Paises, Regiones, Ciudades, Comunas, Perfiles, Usuarios,
# EstadosReserva, EstadosPago, Hoteles, TiposHabitacion,
# Habitaciones, Clientes, Reservas, ReservasDetalles y Pagos.

GET {{HotelReservaBack.Api_HostAddress}}/api/Hoteles
Accept: application/json

###

